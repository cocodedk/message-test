#!/bin/sh
set -eu

MSG=$(cat "$1")

if echo "$MSG" | head -1 | grep -qE '^(feat|fix|chore|docs|style|refactor|test|ci|build|perf|revert)(\(.+\))?!?: .+'; then
  exit 0
fi

# Merge and revert commits generated by git itself are exempt.
if echo "$MSG" | head -1 | grep -qE '^(Merge|Revert) '; then
  exit 0
fi

cat >&2 <<'EOF'
ERROR: Commit message must follow Conventional Commits.
  Example: feat: add cosmic-level analogue entries
  Types:   feat|fix|chore|docs|style|refactor|test|ci|build|perf|revert
EOF
exit 1
